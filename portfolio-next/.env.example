# Copy to .env.local for local dev, or set these in Vercel for production.
# In production the admin stays LOCKED until both values below are set properly.

# Admin login password (production: min. 8 characters, not an example value)
ADMIN_PASSWORD=change-me

# Signs the admin session cookie (production: min. 32 random characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=use-a-long-random-string-here

# Production database connection string. Vercel Storage (Neon) injects this
# automatically (POSTGRES_URL is accepted too). Empty in dev -> content is
# stored in a local file: data/content.json
DATABASE_URL=

# If your Postgres does NOT use SSL, uncomment:
# PGSSL=disable
