# Copy to .env.local for local dev, or set these in Vercel for production.

# Admin login password (change this!)
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (use a long random string)
SESSION_SECRET=use-a-long-random-string-here

# Production database (Vercel Postgres / Neon / Supabase connection string).
# When DATABASE_URL is set, content is stored in Postgres.
# When it is empty (dev), content is stored in a local file: data/content.json
DATABASE_URL=

# If your Postgres does NOT require SSL, uncomment:
# PGSSL=disable
